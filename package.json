{
  "name": "sechsnimmtv2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#engine/*": "./src/engine/*",
    "#client/*": "./src/client/*",
    "#server/*": "./src/server/*",
    "#testSupport/*": "./src/engine/testSupport/*"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "npm run lint && tsc && vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "host": "npm run build && npm start",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run .integration.test.",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.14.0",
    "express": "5.3.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.7",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
