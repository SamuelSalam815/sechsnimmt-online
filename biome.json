{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noUnsafeTypeAssertion": "error",
        "noUselessTypeAssertion": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Import through a reference of package.json, so that the component boundary is part of the import"
              },
              {
                "group": ["#engine/testSupport/*"],
                "message": "Test support has the reference #testSupport/*"
              },
              {
                "group": ["#testSupport/*", "**/*.test.ts"],
                "message": "Test code is for tests. A production module must not import it"
              }
            ],
            "paths": {
              "@reduxjs/toolkit": {
                "allowImportNames": ["createEntityAdapter", "EntityState"],
                "message": "Only the reducers and the store code apply changes. Other code reads plain state and imports no Redux Toolkit API that changes it. See docs/game-flow-architecture.md"
              },
              "immer": "Only the reducers and the store code apply changes. Other code reads plain state and imports no Redux Toolkit API that changes it. See docs/game-flow-architecture.md"
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/engine/reducers/**",
        "src/engine/store.ts",
        "src/client/clientStore.ts",
        "src/server/roomStore/**",
        "src/server/infrastructure/logger.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Import through a reference of package.json, so that the component boundary is part of the import"
                  },
                  {
                    "group": ["#engine/testSupport/*"],
                    "message": "Test support has the reference #testSupport/*"
                  },
                  {
                    "group": ["#testSupport/*", "**/*.test.ts"],
                    "message": "Test code is for tests. A production module must not import it"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "src/engine/testSupport/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Import through a reference of package.json, so that the component boundary is part of the import"
                  },
                  {
                    "group": ["#engine/testSupport/*"],
                    "message": "Test support has the reference #testSupport/*"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
